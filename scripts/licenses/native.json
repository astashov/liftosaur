{
  "_readme": [
    "Curated inventory of native code that ships inside the iOS/Android apps but never",
    "appears in the JS bundle. build-licenses.ts fails if ios/Podfile.lock or a build.gradle",
    "contains something not covered here, so new native dependencies force an update.",
    "'npmPackage' entries reuse the license text already on disk in node_modules."
  ],

  "reactNativePodPrefixes": ["React", "RCT", "Yoga", "FBLazyVector", "FBReactNativeSpec"],

  "podToNpm": {
    "react-native-appsflyer": "react-native-appsflyer",
